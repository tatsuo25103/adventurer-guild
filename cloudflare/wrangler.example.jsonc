{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adventurer-guild-api",
  "main": "src/index.js",
  "compatibility_date": "2026-06-07",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adventurer-guild-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
